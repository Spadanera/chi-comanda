{
  "name": "chi-comanda-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --poll ./src/index.ts",
    "build": "rimraf ./dist && tsc -b",
    "build-main": "cd .. && npm run build",
    "start": "node dist/index.js",
    "version": "tsc -v",
    "test": "vitest run",
    "test:db": "docker run -d --rm --name chicomanda-test-db -e MYSQL_DATABASE=railway -e MYSQL_USER=user -e MYSQL_PASSWORD=password -e MYSQL_ROOT_PASSWORD=password -p 3317:3306 mysql:9",
    "typecheck": "tsc -b ../models && tsc --noEmit -p ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-history-api-fallback": "^2.0.0",
    "express": "^4.21.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "node-mailjet": "^6.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.4",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.6",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}

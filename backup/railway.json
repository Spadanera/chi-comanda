{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backup/Dockerfile",
    "watchPatterns": ["backup/**", "scripts/backup-cron.mjs", "scripts/backup-client.mjs", "scripts/lib/**"]
  },
  "deploy": {
    "cronSchedule": "30 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
